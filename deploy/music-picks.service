[Unit]
Description=music-picks daily email
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=user
WorkingDirectory=/home/user/music-picks
Environment=METRICS_FILE=/home/user/monitoring/textfile/music_picks.prom
ExecStart=/usr/bin/python3 -I /home/user/music-picks/app/music_picks.py pick
TimeoutStartSec=9h
