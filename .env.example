# Optional: read shared values (SMTP_*, MAIL_FROM, RECIPIENTS, DATABASE_URL) from movie-picks' .env;
# anything set below overrides it.
SHARED_ENV=/home/user/movie-picks/.env

# Soulseek account for slskd (any free username/password: the account is created on first login)
SLSK_USERNAME=
SLSK_PASSWORD=

PUBLIC_URL=https://music.example.com
# random string for signing links: python3 -c 'import secrets;print(secrets.token_hex(32))'
LINK_SECRET=
WEB_PORT=8791
# PICKS_PER_DAY=   (empty = one album for every taste direction; a number caps it)
CLAUDE_MODEL=opus
# sender display name; the address comes from MAIL_FROM
MAIL_NAME=Music Picks
# RECIPIENTS= / MAIL_FROM= / SMTP_USER= / SMTP_PASSWORD= / DATABASE_URL=   (if not taken from SHARED_ENV)
